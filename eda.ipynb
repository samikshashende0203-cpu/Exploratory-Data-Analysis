import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

sns.set_theme(style="whitegrid")
df = pd.read_csv("data.csv")

print("First five rows:")
display(df.head())
print("Dataset shape:", df.shape)

print("\nColumn names:")
print(df.columns.tolist())

print("\nDataset information:")
df.info()
print("Missing values:")
print(df.isnull().sum())

print("\nDuplicate rows:", df.duplicated().sum())
display(df.describe(include="all"))
plt.figure(figsize=(8, 5))

sns.countplot(
    data=df,
    x="Department",
    order=df["Department"].value_counts().index
)

plt.title("Students by Department")
plt.xlabel("Department")
plt.ylabel("Number of Students")
plt.xticks(rotation=30)
plt.tight_layout()
plt.show()
plt.figure(figsize=(8, 5))

sns.histplot(data=df, x="Marks", bins=8, kde=True)

plt.title("Distribution of Student Marks")
plt.xlabel("Marks")
plt.ylabel("Frequency")
plt.tight_layout()
plt.show()
print("EDA completed successfully!")
print("The dataset was analyzed using statistics and visualizations.")
print("Charts include department counts, marks distribution,")
print("placement status, and a correlation heatmap.")
